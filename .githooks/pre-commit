#!/bin/bash
# Pre-commit hook: run linters and tests before allowing a commit.
# Install: git config core.hooksPath .githooks
#
# A missing tool is never silent: it prints "SKIPPED: <tool> not installed".
# Locally that is a warning (exit 0); with CI_STRICT=1 it fails the commit.

echo "Running pre-commit checks..."
FAILED=0

# skipped TOOL [REASON]: report a missing tool loudly; fail under CI_STRICT=1.
skipped() {
  echo "  SKIPPED: $1 ${2:-not installed}"
  if [ "${CI_STRICT:-0}" = "1" ]; then
    echo "  CI_STRICT=1: a skipped check is a failure"
    FAILED=1
  fi
}

# run LABEL CMD...: run a check, show its output only when it fails.
run() {
  local label=$1 out
  shift
  echo -n "  $label... "
  if out=$("$@" 2>&1); then
    echo "ok"
  else
    echo "FAILED"
    printf '%s\n' "$out"
    FAILED=1
  fi
}

# Lua linter
if command -v luacheck &>/dev/null; then
  run luacheck luacheck extension/SchwabPortfolio.lua --quiet
elif [ -x "$HOME/.luarocks/bin/luacheck" ]; then
  run luacheck "$HOME/.luarocks/bin/luacheck" extension/SchwabPortfolio.lua --quiet
else
  skipped luacheck
fi

# Shell linter
if command -v shellcheck &>/dev/null; then
  run shellcheck shellcheck install.sh sync.sh tests/test_xlsx2csv.sh \
    tests/test_check_personal_data.sh tools/check_personal_data.sh
else
  skipped shellcheck
fi

# AppleScript syntax check (macOS only)
if command -v osacompile &>/dev/null; then
  TMPDIR_APP=$(mktemp -d)
  run osacompile osacompile -o "$TMPDIR_APP/SchwabSync.app" shortcut/SchwabSync.applescript
  rm -rf "$TMPDIR_APP"
else
  skipped osacompile "not available (macOS only)"
fi

# Perl converter syntax + golden test
if command -v perl &>/dev/null; then
  run xlsx2csv bash -c 'perl -c xlsx2csv && bash tests/test_xlsx2csv.sh'
else
  skipped perl
fi

# Lua tests
LUA=$(command -v lua5.3 || command -v lua || echo /opt/local/bin/lua)
if [ -x "$LUA" ]; then
  run tests "$LUA" extension/SchwabPortfolio.lua
else
  skipped lua
fi

# Secrets and personal data check: the same script CI runs, over the staged
# blobs. On a hit it prints file:line and the rule, never the value.
echo -n "  secrets... "
if scan_out=$(tools/check_personal_data.sh --staged 2>&1); then
  echo "ok"
else
  echo "FAILED (possible personal data in staged changes)"
  printf '%s\n' "$scan_out"
  FAILED=1
fi
run "scanner test" bash tests/test_check_personal_data.sh

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "Pre-commit checks failed. Fix the issues above before committing."
  exit 1
fi

echo "All checks passed."
